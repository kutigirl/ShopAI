// prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Product {
  id        String   @id
  name      String
  price     Int
  image     String
  createdAt DateTime @default(now())
}

model Order {
  id        String      @id
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  total     Int
  status    String      @default("PENDING")
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  quantity  Int
  price     Int
}
